import { useRef, useMemo, useState, useEffect, Suspense } from 'react';
import { Canvas, extend, useFrame, useLoader } from "@react-three/fiber";
import { shaderMaterial } from "@react-three/drei";
import * as THREE from 'three';
import { BufferAttribute, Points, TextureLoader } from 'three';
import glsl from "babel-plugin-glsl/macro";

// AnimatedSphere remains unchanged.
function AnimatedSphere() {
  const meshRef = useRef();

  useFrame(() => {
    const mesh = meshRef.current;
    mesh.rotation.y += 0.01;
    mesh.material.emissiveIntensity = (1 + Math.sin(Date.now() * 0.001)) * 0.5;
    mesh.material.color = new THREE.Color('green');
  });

  return (
    <mesh ref={meshRef}>
      <sphereGeometry args={[2, 32, 32]} />
      <meshStandardMaterial color="blue" emissive="blue" wireframe />
    </mesh>
  );
}

// Updated shader material with additional uniforms
const ParticleShaderMaterial = shaderMaterial(
  {
    u_time: 0,
    u_radius_min: 1.5,
    u_radius_max: 3.0
  },
  // Vertex shader
  glsl`
  uniform float u_time;
  uniform float u_radius_min;
  uniform float u_radius_max;
  attribute float a_speed;
  attribute float a_radius_offset;
  attribute float a_height;
  attribute float a_angle;

  varying vec3 vColor;

  void main() {
      float radius = u_radius_min + a_radius_offset * (u_radius_max - u_radius_min);
      float angle = a_angle + u_time * a_speed;

      float x = radius * cos(angle);
      float y = a_height;
      float z = radius * sin(angle);

      vec3 pos = vec3(x, y, z);
      gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);

      vColor = vec3(a_height * 0.5 + 0.5, 0.4, 0.6);
  }
  `,
  // Fragment shader
  glsl`
  varying vec3 vColor;

  void main() {
      gl_FragColor = vec4(vColor, 1.0);
  }
  `
);

extend({ ParticleShaderMaterial });

function Particles({ count = 1000 }) {
  const meshRef = useRef();

  const [positions, speeds, radiusOffsets, heights, angles] = useMemo(() => {
    const positions = new Float32Array(count * 3); // x, y, z per particle
    const speeds = new Float32Array(count);
    const radiusOffsets = new Float32Array(count);
    const heights = new Float32Array(count);
    const angles = new Float32Array(count);

    for (let i = 0; i < count; i++) {
      speeds[i] = 0.01 + Math.random() * 0.02;
      radiusOffsets[i] = Math.random();
      heights[i] = -1 + Math.random() * 2;
      angles[i] = Math.random() * Math.PI * 2;
    }

    return [positions, speeds, radiusOffsets, heights, angles];
  }, [count]);

  useFrame(({ clock }) => {
    const mesh = meshRef.current;
    mesh.material.uniforms.u_time.value = clock.getElapsedTime();
  });

  return (
    <instancedMesh ref={meshRef} args={[null, null, count]}>
      <sphereBufferGeometry args={[0.5, 8, 8]} />
      <particleShaderMaterial
        uniforms={{
          u_time: { value: 0 },
          u_radius_min: { value: 1.5 },
          u_radius_max: { value: 3.0 }
        }}
        attach="material"
      />
    </instancedMesh>
  );
}

function Scene() {
  return (
    <Canvas style={{ width: '100vw', height: '100vh', background: 'black' }}>
      <ambientLight intensity={0.5} />
      <pointLight position={[10, 10, 10]} />
      <AnimatedSphere />
      <Particles />
      <Suspense fallback={null}>
        <Particles />
      </Suspense>
      <camera position={[0, 0, 20]} />
    </Canvas>
  );
}

export default Scene;
